{
  "family": "greenfield-python",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::030454160336:role/exam-ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "greenfield-python",
      "image": "placeholder",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "greenfield-python-8080-tcp",
          "appProtocol": "http"
        }
      ]
    }
  ]
}